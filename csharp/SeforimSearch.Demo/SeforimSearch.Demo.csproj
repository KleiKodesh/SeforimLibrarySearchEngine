<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The demo CLI and selftest: the FtsLib-shaped facade (SeforimSearch.FtsFacade, no SQLite)
    over its default seforim.db data source (SeforimSearch.SeforimDb).

    Builds and runs on both .NET 10 and .NET Framework 4.8.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Core's sources rely on implicit usings; on net48 the SDK adds the same set. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The native engine is x64 on Windows. Elsewhere (macOS arm64 / x64, Linux) the
         net10.0 build stays AnyCPU and loads the host's own libseforim_search_native. -->
    <PlatformTarget Condition="'$(OS)' == 'Windows_NT'">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(TargetFramework)' == 'net48'">win-x64</RuntimeIdentifier>
    <RootNamespace>SeforimSearch.Demo</RootNamespace>
    <!-- CS0436: the net48 polyfills are linked into each project and visible through
         InternalsVisibleTo; the local copy wins, as intended. -->
    <NoWarn>$(NoWarn);CS0436;CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeforimSearch.Engine\SeforimSearch.Engine.csproj" />
    <ProjectReference Include="..\SeforimSearch.FtsFacade\SeforimSearch.FtsFacade.csproj" />
    <ProjectReference Include="..\SeforimSearch.SeforimDb\SeforimSearch.SeforimDb.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Include="..\SeforimSearch.FtsFacade\Compat\NetFrameworkPolyfills.cs" Link="Compat\NetFrameworkPolyfills.cs" />
    <Using Include="SeforimSearch.Demo.Compat" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

</Project>
