# Benchmark configuration (bash syntax; sourced by run-all.sh). Copy to bench.local.env
# to override on one machine (bench.local.env is git-ignored and read after this file).
# Command-line flags (--db, --out, --steps) override both.

# seforim.db: empty = search the defaults per OS (Otzaria, then Zayit), then $OUT_DIR/data,
# else download Otzaria's latest release into $OUT_DIR/data (tools/bench/get_db.py).
DB_PATH=""

# Where everything produced goes: indexes, logs, run dirs, the downloaded DB (~10 GB + DB).
OUT_DIR="$HOME/seforim-bench"

# KitveiHakodesh checkout (FtsLib + Core source for FtsLibDump). Empty = the submodule
# external/KleiKodeshProject/KitveiHakodesh.
KITVEI_DIR=""

# Index dirs (empty = under $OUT_DIR/indexes).
IDX_POS=""
IDX_NOPOS=""
IDX_MARKS=""
IDX_FTSLIB=""
IDX_OTZARIA=""

# Steps run by default (see run-all.sh --help).
STEPS="detect,db,build-tools,build-indexes,parity,speed,hitcount,report"

# Speed: timed runs per query (median), after one warm-up.
RUNS=3
# Query sets for speed / hit counts, and for FtsLib parity.
SPEED_SETS="large words rules"
PARITY_SETS="diff10 large words rules ketiv"
PARITY_MAX_HITS=20000
